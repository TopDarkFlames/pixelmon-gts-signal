[Unit]
Description=Pixelmon GTS - painel, alertas e Tailscale Funnel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/scripts/iniciar_permanente.sh
Restart=always
RestartSec=8
SuccessExitStatus=143
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
