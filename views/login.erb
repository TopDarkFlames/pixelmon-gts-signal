<section class="auth-layout login-shell">
  <section class="auth-visual" aria-labelledby="login-product-title">
    <div class="auth-identity">
      <picture class="auth-logo-picture">
        <source srcset="/icons/logo-zex-alpha.webp?v=2" type="image/webp">
        <img class="auth-logo-image" src="/icons/Logo.png?v=2" alt="Zex.py">
      </picture>

      <div class="auth-copy">
        <p class="auth-overline">MONITORAMENTO DO GTS GLOBAL</p>
        <h1 id="login-product-title">Pixelmon GTS Signal</h1>
        <p>Ofertas ao vivo, histórico de preços e alertas personalizados em um painel privado.</p>
      </div>
    </div>
  </section>

  <section class="auth-card login-card" aria-labelledby="login-title">
    <div class="login-heading">
      <span class="section-code">ACESSO PRIVADO</span>
      <h2 id="login-title">Bem-vindo de volta</h2>
      <p class="muted">Entre com sua conta para acessar o painel.</p>
    </div>

    <% if message %><p class="notice"><%= h(message) %></p><% end %>

    <form method="post" action="/login" class="login-form">
      <label>
        <span>Email</span>
        <span class="login-input">
          <input name="email" type="email" required autocomplete="email" inputmode="email" placeholder="nome@exemplo.com">
        </span>
      </label>

      <label>
        <span class="login-label-row">
          <span>Senha</span>
          <a href="/forgot-password">Esqueceu a senha?</a>
        </span>
        <span class="login-input password-input">
          <input name="password" type="password" required autocomplete="current-password" placeholder="Digite sua senha" data-password-input>
          <button type="button" class="password-reveal" data-password-toggle aria-label="Mostrar senha" aria-pressed="false">Mostrar</button>
        </span>
      </label>

      <button type="submit" class="login-submit">
        <span>Entrar</span>
        <b aria-hidden="true">→</b>
      </button>
    </form>

    <div class="login-card-foot">
      <p>Não possui acesso? <a href="/register">Solicitar convite</a></p>
    </div>
  </section>
</section>
