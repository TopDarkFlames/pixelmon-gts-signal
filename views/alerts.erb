<section class="dashboard-head compact-head">
  <div><span class="eyebrow">WATCHLIST / PERSONALIZADO</span><h1>Central de alertas</h1><p>Defina o que vale sua atenção; o coletor faz o resto.</p></div>
  <div class="admin-stamp"><strong><%= @alerts.count { |alert| alert['active'].to_i == 1 } %></strong><span>ativos</span></div>
</section>

<section class="two-column-layout">
  <article class="card sticky-card">
    <span class="section-code">NOVO MONITOR</span><h2>Criar alerta</h2>
    <form method="post" action="/alerts" class="stack-form">
      <input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>">
      <label>Item, Pokémon ou vendedor<input name="query" required minlength="2" maxlength="80" placeholder="Ex.: Marshadow"></label>
      <label>Moeda<select name="price_type"><option value="all">Qualquer moeda</option><option value="money">PokéCoins</option><option value="token">Tokens</option><option value="site">Saldo no site</option></select></label>
      <div class="field-pair"><label>Preço mínimo<input name="min_amount" type="number" min="0" step="0.01"></label><label>Preço máximo<input name="max_amount" type="number" min="0" step="0.01"></label></div>
      <fieldset class="channel-options"><legend>Notificar também em</legend><label><input type="checkbox" name="discord" value="1"> Discord</label><label><input type="checkbox" name="telegram" value="1"> Telegram</label></fieldset>
      <button type="submit">Ativar monitor</button>
      <small>O site sempre registra os resultados. IDs externos são configurados em <a href="/settings">Preferências</a>.</small>
    </form>
  </article>

  <div>
    <section class="card">
      <span class="section-code">MONITORES</span><h2>Alertas configurados</h2>
      <% if @alerts.empty? %><p class="empty-state">Você ainda não criou alertas.</p><% end %>
      <div class="alert-list">
        <% @alerts.each do |alert| %>
          <article class="alert-row <%= 'is-paused' if alert['active'].to_i.zero? %>">
            <div><strong><%= h(alert['query']) %></strong><span><%= h(alert['price_type'] == 'all' ? 'todas as moedas' : alert['price_type']) %> · <%= h(alert['channels']) %></span><small><%= format_number(alert['min_amount']) %> — <%= format_number(alert['max_amount']) %></small></div>
            <form method="post" action="/alerts/<%= alert['id'] %>" class="actions"><input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>"><button name="action" value="toggle" class="secondary"><%= alert['active'].to_i == 1 ? 'Pausar' : 'Ativar' %></button><button name="action" value="delete" class="danger">Excluir</button></form>
          </article>
        <% end %>
      </div>
    </section>

    <section class="card">
      <span class="section-code">ÚLTIMOS MATCHES</span><h2>Resultados encontrados</h2>
      <% if @matches.empty? %><p class="empty-state">Nenhum alerta encontrou uma oferta ainda.</p><% end %>
      <div class="match-list">
        <% @matches.each do |match| %>
          <a href="/listing/<%= match['listing_id'] %>"><span><%= h(match['query']) %></span><strong><%= h(match['item']) %></strong><small><%= h(match['price']) %> · <%= h(match['seller']) %></small></a>
        <% end %>
      </div>
    </section>
  </div>
</section>
