<section class="dashboard-head admin-head">
  <div><span class="eyebrow">CONTROLE DE ACESSO / ADMIN</span><h1>Central de operadores</h1><p>Aprove contas, emita convites e acompanhe acessos.</p></div>
  <div class="admin-stamp"><strong><%= format("%02d", @pending.length) %></strong><span>pendentes</span></div>
</section>

<section class="card">
  <span class="section-code">FILA DE APROVAÇÃO</span><h2>Solicitações pendentes</h2>
  <% if @pending.empty? %><p class="empty-state">Nenhuma solicitação pendente.</p><% end %>
  <div class="list">
    <% @pending.each do |user| %>
      <article class="user-row">
        <div><strong><%= h(user["name"]) %></strong><span><%= h(user["email"]) %></span><small><%= h(user["role"]) %> · <%= h(user["status"]) %> · <%= format_utc(user["created_at"]) %></small></div>
        <form method="post" action="/admin/user" class="actions">
          <input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>">
          <input type="hidden" name="user_id" value="<%= user['id'] %>">
          <button name="action" value="approve" type="submit">Aprovar</button>
          <button name="action" value="deny" type="submit" class="secondary">Recusar</button>
        </form>
      </article>
    <% end %>
  </div>
</section>

<section class="card">
  <span class="section-code">CREDENCIAL TEMPORÁRIA</span><h2>Novo convite</h2>
  <form method="post" action="/admin/invite" class="inline-form">
    <input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>">
    <label>Observação<input name="note" placeholder="Ex.: amigo do servidor"></label>
    <label>Usos<input name="max_uses" type="number" min="1" value="1"></label>
    <button type="submit">Gerar convite</button>
  </form>
  <div class="table-wrap"><table><thead><tr><th>Código</th><th>Observação</th><th>Usos</th><th>Status</th></tr></thead><tbody>
    <% @invites.each do |invite| %><tr><td><code><%= h(invite["code"]) %></code></td><td><%= h(invite["note"]) %></td><td><%= invite["used_count"] %>/<%= invite["max_uses"] %></td><td><%= invite["active"].to_i == 1 ? "ativo" : "inativo" %></td></tr><% end %>
  </tbody></table></div>
</section>

<section class="card">
  <span class="section-code">DIRETÓRIO</span><h2>Usuários recentes</h2>
  <div class="list compact">
    <% @users.each do |user| %><article class="user-row"><div><strong><%= h(user["name"]) %></strong><span><%= h(user["email"]) %></span><small><%= h(user["role"]) %> · <%= h(user["status"]) %> · <%= format_utc(user["created_at"]) %></small></div></article><% end %>
  </div>
</section>
