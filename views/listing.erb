<section class="dashboard-head compact-head">
  <div class="listing-title">
    <% if listing_image_url(@listing) %><span class="listing-hero-asset"><img src="/listing/<%= @listing['id'] %>/image" alt="Sprite de <%= h(@listing['item']) %>"></span><% end %>
    <div>
      <span class="eyebrow">MARKET RECORD / #<%= @listing['id'] %></span>
      <h1><%= h(@listing['item']) %></h1>
      <% unless @listing['texture'].to_s.empty? %>
        <div class="pokemon-meta detail-tags">
          <span class="texture-tag <%= custom_texture?(@listing) ? 'custom' : 'original' %>">TXT <%= h(@listing['texture']) %></span>
          <% unless pokemon_listing?(@listing) %><span>Textura avulsa</span><% end %>
        </div>
      <% end %>
      <p>Anunciado por <a href="/seller/<%= CGI.escapeURIComponent(@listing['seller'].to_s) %>"><strong><%= h(@listing['seller']) %></strong></a> em <%= h(format_detected_at(@listing['detected_at'])) %>.</p>
    </div>
  </div>
  <div class="detail-actions"><span class="currency currency-<%= price_type(@listing) %> hero-price"><%= h("#{@listing['amount']} #{@listing['currency']}".strip) %></span><form method="post" action="/favorites" class="favorite-form"><input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>"><input type="hidden" name="kind" value="item"><input type="hidden" name="value" value="<%= h(@listing['item']) %>"><input type="hidden" name="return_to" value="/listing/<%= @listing['id'] %>"><button class="favorite-button detail-favorite <%= 'is-favorite' if favorite?('item', @listing['item']) %>" title="Favoritar item">★</button></form></div>
</section>

<% if @listing_stats %>
  <section class="memory-strip">
    <article><span>Aparições</span><strong><%= @listing_stats["appearances"] %>x</strong><small>mesmo item + TXT + moeda</small></article>
    <article><span>Mediana</span><strong><%= h(format_number(@listing_stats["median_amount"])) %></strong><small>histórico salvo</small></article>
    <article><span>Menor / maior</span><strong><%= h(format_number(@listing_stats["min_amount"])) %> · <%= h(format_number(@listing_stats["max_amount"])) %></strong><small>faixa registrada</small></article>
    <article><span>Primeira vez</span><strong><%= h(format_utc(@listing_stats["first_seen_epoch"])) %></strong><small>arquivo vivo do GTS</small></article>
  </section>
<% end %>

<% if pokemon_listing?(@listing) %>
  <section class="card pokemon-profile">
    <div class="panel-heading">
      <div><span class="section-code">PIXELMON DATA / HOVER CAPTURE</span><h2>Pokémon Profile</h2></div>
      <% unless @listing['texture'].to_s.empty? %><span class="texture-status <%= custom_texture?(@listing) ? 'custom' : 'original' %>"><small>TEXTURE</small><strong><%= h(pokemon_profile_value(@listing['texture'])) %></strong></span><% end %>
    </div>
    <div class="pokemon-profile-grid">
      <% pokemon_profile_fields(@listing).each do |label, value| %>
        <% unless value.to_s.empty? %><div><span><%= label %></span><strong><%= h(value) %></strong></div><% end %>
      <% end %>
    </div>
    <% if @listing['iv_total'] %>
      <div class="stat-spread"><div class="spread-heading"><span>IVs <% if hidden_ability?(@listing) %><b class="ha-tag">HA</b><% end %></span><strong><%= @listing['iv_total'] %>/<%= @listing['iv_max'] %> · <%= format('%.2f', @listing['iv_percent']) %>%</strong></div><div class="spread-values"><% pokemon_stats(@listing, 'iv').each do |label, value| %><span><small><%= label %></small><strong><%= value.nil? ? '—' : value %></strong></span><% end %></div></div>
    <% end %>
    <% if @listing['ev_total'] %>
      <div class="stat-spread ev"><div class="spread-heading"><span>EVs</span><strong><%= @listing['ev_total'] %>/<%= @listing['ev_max'] %> · <%= format('%.2f', @listing['ev_percent']) %>%</strong></div><div class="spread-values"><% pokemon_stats(@listing, 'ev').each do |label, value| %><span><small><%= label %></small><strong><%= value.nil? ? '—' : value %></strong></span><% end %></div></div>
    <% end %>
    <% moves = listing_moves(@listing) %>
    <% unless moves.empty? %><div class="move-section"><span>MOVES</span><div class="move-list"><% moves.each do |move| %><strong><%= h(move) %></strong><% end %></div></div><% end %>
  </section>
<% elsif !@listing['texture'].to_s.empty? %>
  <section class="card texture-record">
    <span class="section-code">POKÉMON TXT / TEXTURE ITEM</span>
    <h2><%= h(@listing['item']) %></h2>
    <div class="pokemon-meta detail-tags">
      <span class="texture-tag custom">TXT <%= h(@listing['texture']) %></span>
      <span>No IV data</span>
    </div>
    <p>Este registro é uma textura avulsa encontrada no NBT do item anunciado. Por isso o site mostra a TXT, mas não mostra IVs, nature e habilidade como em um Pokémon completo.</p>
  </section>
<% end %>

<section class="card comparison-card">
  <div class="panel-heading"><div><span class="section-code">COMPARAÇÃO TEMPORAL</span><h2>Preço e volume</h2></div><span class="trend-badge <%= @weekly_trend.to_i > 0 ? 'up' : (@weekly_trend.to_i < 0 ? 'down' : 'flat') %>"><% if @weekly_trend %><%= @weekly_trend.positive? ? '↑' : (@weekly_trend.negative? ? '↓' : '→') %> <%= @weekly_trend.abs %>% na semana<% else %>tendência sem dados<% end %></span></div>
  <div class="comparison-grid">
    <% @period_comparison.each do |label, stats| %>
      <article><span><%= label %></span><strong><%= format_number(stats[:median]) %></strong><small><%= stats[:count] %> anúncios · confiança <%= h(stats[:confidence]) %></small><div><i style="width:<%= [stats[:count] * 5, 100].min %>%"></i></div></article>
    <% end %>
  </div>
</section>

<section class="stats-grid">
  <article class="stat"><span>Menor registrado</span><strong><%= format_number(@price_stats[:min]) %></strong><small>mesmo item e moeda</small></article>
  <article class="stat stat-money"><span>Mediana robusta</span><strong><%= format_number(@price_stats[:median]) %></strong><small><%= @price_stats[:outliers] %> extremos removidos</small></article>
  <article class="stat stat-token"><span>Maior registrado</span><strong><%= format_number(@price_stats[:max]) %></strong><small>janela disponível</small></article>
  <article class="stat stat-site"><span>Confiança</span><strong class="confidence-text"><%= h(@price_stats[:confidence]) %></strong><small><%= @price_stats[:count] %> amostras válidas</small></article>
</section>

<section class="two-column-layout detail-layout">
  <article class="card">
    <span class="section-code">TRAJETÓRIA DE PREÇO</span><h2>Histórico recente</h2>
    <div class="price-chart">
      <% maximum = @price_stats[:max].to_f %>
      <% @price_history.first(24).reverse_each do |row| %>
        <% width = maximum.positive? ? [(row['amount_value'].to_f / maximum * 100).round, 4].max : 4 %>
        <div title="<%= h(row['price']) %>"><span style="width:<%= width %>%"></span><small><%= h(format_detected_at(row['detected_at'])) %></small><strong><%= h(row['amount']) %></strong></div>
      <% end %>
    </div>
  </article>
  <article class="card raw-record">
    <span class="section-code">DADOS ORIGINAIS</span><h2>Registro do anúncio</h2>
    <dl><dt>Preço original</dt><dd><%= h(@listing['price']) %></dd><dt>Vendedor</dt><dd><a href="/seller/<%= CGI.escapeURIComponent(@listing['seller'].to_s) %>"><%= h(@listing['seller']) %></a></dd><dt>Moeda</dt><dd><%= h(@listing['currency']) %></dd><dt>Status</dt><dd><%= h(@listing['status']) %></dd></dl>
    <p class="raw-line"><%= h(@listing['raw_chat']) %></p>
    <a class="button-link secondary-link" href="/dashboard">Voltar ao mercado</a>
  </article>
</section>
