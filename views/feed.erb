<% if @oob %>
  <strong id="stat-total" hx-swap-oob="true"><%= @stats["total"] %></strong>
  <strong id="stat-money" hx-swap-oob="true"><%= @stats["money"] %></strong>
  <strong id="stat-token" hx-swap-oob="true"><%= @stats["token"] %></strong>
  <strong id="stat-site" hx-swap-oob="true"><%= @stats["site"] %></strong>
  <strong id="stat-alerts" hx-swap-oob="true"><%= @stats["alerts"] %></strong>
  <strong id="stat-queue" hx-swap-oob="true"><%= @stats["queue"] %></strong>
<% end %>
<div id="feed-table" data-latest-id="<%= @feed_version.to_i %>" hx-get="/feed" hx-trigger="gts:refresh from:body" hx-include="#feed-controls" hx-swap="outerHTML">
  <% if @rows.empty? %>
    <p class="empty-state">Nenhum anúncio encontrado neste filtro.</p>
  <% else %>
    <div class="table-wrap">
      <table class="market-table">
        <thead><tr><th>Quando</th><th>Item/Pokémon</th><th>Vendedor</th><th>Preço</th><th>Sinal</th></tr></thead>
        <tbody>
          <% @rows.each do |row| %>
            <% kind = price_type(row) %>
            <% image_url = listing_image_url(row) %>
            <tr data-type="<%= kind %>">
              <td class="time-cell" data-label="Quando"><%= h(format_detected_at(row["detected_at"])) %></td>
              <td data-label="Item"><div class="listing-identity"><% if image_url %><a class="listing-thumb" href="/listing/<%= row['id'] %>" aria-label="Ver <%= h(row['item']) %>"><img src="<%= image_url %>" alt="" loading="lazy"></a><% end %><div><div class="favorite-line"><a class="item-name" href="/listing/<%= row['id'] %>"><%= h(row["item"]) %></a><form method="post" action="/favorites" class="favorite-form"><input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>"><input type="hidden" name="kind" value="item"><input type="hidden" name="value" value="<%= h(row['item']) %>"><input type="hidden" name="return_to" value="<%= h(market_return_path) %>"><button class="favorite-button <%= 'is-favorite' if favorite?('item', row['item']) %>" type="submit" title="<%= favorite?('item', row['item']) ? 'Remover item dos favoritos' : 'Favoritar item' %>">★</button></form></div><% if pokemon_listing?(row) %><div class="pokemon-meta"><span>Pokémon</span><% if row['iv_percent'] %><span>IV <%= format('%.2f', row['iv_percent']) %>%</span><% end %><% if hidden_ability?(row) %><span class="ha-tag">HA</span><% end %><% unless row['texture'].to_s.empty? %><span class="texture-tag <%= custom_texture?(row) ? 'custom' : 'original' %>">TXT <%= h(row['texture']) %></span><% end %></div><% elsif !row['texture'].to_s.empty? %><div class="pokemon-meta"><span class="texture-tag custom">TXT <%= h(row['texture']) %></span></div><% end %><small class="mobile-seller">por <%= h(row["seller"]) %></small></div></div></td>
              <td class="seller-cell" data-label="Vendedor"><div class="favorite-line"><a href="/seller/<%= CGI.escapeURIComponent(row['seller'].to_s) %>"><%= h(row["seller"]) %></a><form method="post" action="/favorites" class="favorite-form"><input type="hidden" name="csrf" value="<%= h(@current_user['csrf_token']) %>"><input type="hidden" name="kind" value="seller"><input type="hidden" name="value" value="<%= h(row['seller']) %>"><input type="hidden" name="return_to" value="<%= h(market_return_path) %>"><button class="favorite-button <%= 'is-favorite' if favorite?('seller', row['seller']) %>" type="submit" title="<%= favorite?('seller', row['seller']) ? 'Remover vendedor dos favoritos' : 'Favoritar vendedor' %>">★</button></form></div></td>
              <td data-label="Preço"><span class="currency currency-<%= kind %>"><%= h("#{row['amount']} #{row['currency']}".strip) %></span></td>
              <td data-label="Sinal">
                <% if row["deal"] %>
                  <a class="deal-pill" href="/listing/<%= row['id'] %>" title="<%= row['market_samples'] %> amostras · confiança <%= h(row['market_confidence']) %>">↓ <%= row["discount_percent"] %>% abaixo</a>
                <% else %>
                  <span class="status-pill"><i></i>detectado</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% pages = (@total_rows.to_f / PixelmonGTSPanel::FEED_PAGE_SIZE).ceil %>
    <% if pages > 1 %>
      <nav class="pagination" aria-label="Paginação do mercado">
        <% if @page > 1 %><a href="?<%= Rack::Utils.build_query(params.to_h.merge('page' => @page - 1)) %>">Anterior</a><% end %>
        <span>Página <strong><%= @page %></strong> de <%= pages %></span>
        <% if @page < pages %><a href="?<%= Rack::Utils.build_query(params.to_h.merge('page' => @page + 1)) %>">Próxima</a><% end %>
      </nav>
    <% end %>
  <% end %>
</div>
