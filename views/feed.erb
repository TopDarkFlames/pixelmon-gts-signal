<% if @oob %>
  <strong id="stat-total" hx-swap-oob="true"><%= @stats["total"] %></strong>
  <strong id="stat-money" hx-swap-oob="true"><%= @stats["money"] %></strong>
  <strong id="stat-token" hx-swap-oob="true"><%= @stats["token"] %></strong>
  <strong id="stat-site" hx-swap-oob="true"><%= @stats["site"] %></strong>
  <strong id="stat-alerts" hx-swap-oob="true"><%= @stats["alerts"] %></strong>
  <strong id="stat-queue" hx-swap-oob="true"><%= @stats["queue"] %></strong>
<% end %>
<div id="feed-table" data-latest-id="<%= @rows.first&.fetch('id', 0) || 0 %>" hx-get="/feed" hx-trigger="gts:refresh from:body" hx-include="#feed-controls" hx-swap="outerHTML">
  <% if @rows.empty? %>
    <p class="empty-state">Nenhum anúncio encontrado neste filtro.</p>
  <% else %>
    <div class="table-wrap">
      <table class="market-table">
        <thead><tr><th>Quando</th><th>Item/Pokémon</th><th>Vendedor</th><th>Preço</th><th>Sinal</th></tr></thead>
        <tbody>
          <% @rows.each do |row| %>
            <% kind = price_type(row) %>
            <tr data-type="<%= kind %>">
              <td class="time-cell" data-label="Quando"><%= h(format_detected_at(row["detected_at"])) %></td>
              <td data-label="Item"><a class="item-name" href="/listing/<%= row['id'] %>"><%= h(row["item"]) %></a><small class="mobile-seller">por <%= h(row["seller"]) %></small></td>
              <td class="seller-cell" data-label="Vendedor"><%= h(row["seller"]) %></td>
              <td data-label="Preço"><span class="currency currency-<%= kind %>"><%= h("#{row['amount']} #{row['currency']}".strip) %></span></td>
              <td data-label="Sinal">
                <% if row["deal"] %>
                  <span class="deal-pill">↓ <%= row["discount_percent"] %>% abaixo</span>
                <% else %>
                  <span class="status-pill"><i></i>detectado</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% pages = (@total_rows.to_f / PixelmonGTSPanel::FEED_PAGE_SIZE).ceil %>
    <% if pages > 1 %>
      <nav class="pagination" aria-label="Paginação do mercado">
        <% if @page > 1 %><a href="?<%= Rack::Utils.build_query(params.to_h.merge('page' => @page - 1)) %>">Anterior</a><% end %>
        <span>Página <strong><%= @page %></strong> de <%= pages %></span>
        <% if @page < pages %><a href="?<%= Rack::Utils.build_query(params.to_h.merge('page' => @page + 1)) %>">Próxima</a><% end %>
      </nav>
    <% end %>
  <% end %>
</div>
