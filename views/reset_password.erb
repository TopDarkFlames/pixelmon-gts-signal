<section class="card auth-card narrow request-card"><span class="section-code">NOVA CREDENCIAL</span><h1>Defina sua nova senha</h1><% if message %><p class="notice"><%= h(message) %></p><% end %><form method="post" action="/reset-password"><input type="hidden" name="token" value="<%= h(@reset_token) %>"><label>Nova senha <span class="label-note">mínimo de 10 caracteres</span><input type="password" name="password" required minlength="10" autocomplete="new-password"></label><button type="submit">Alterar senha</button></form></section>
