{
  "read_from_start": false,
  "poll_interval_seconds": 0.03,
  "max_seen_lines": 2000,
  "gts_bridge": {
    "enabled": true,
    "path": "",
    "read_from_start": false,
    "duplicate_window_seconds": 0.75
  },
  "traveling_merchant": {
    "enabled": true,
    "world": "lohr",
    "pending_window_seconds": 8
  },
  "print_filtered": false,
  "use_embeds": true,
  "show_original_price": true,
  "show_raw_log": false,
  "embed_colors": {
    "money": "#F1C40F",
    "token": "#9B59B6",
    "site": "#2ECC71",
    "desconhecido": "#5865F2",
    "default": "#5865F2"
  },
  "history": {
    "enabled": true,
    "database": "access_panel.db",
    "path": "gts_history.csv",
    "write_dry_run": false,
    "write_filtered": true
  },
  "filters": {
    "enabled": true,
    "allowed_price_types": [],
    "blocked_price_types": [],
    "required_keywords": [],
    "ignored_keywords": [],
    "allowed_sellers": [],
    "blocked_sellers": [],
    "price_limits": {
      "money": {
        "min": null,
        "max": null
      },
      "token": {
        "min": null,
        "max": null
      },
      "site": {
        "min": null,
        "max": null
      }
    }
  },
  "message_template": "GTS Global detectado\nItem/Pokémon: {item}\nQuantidade: {amount}\nTipo: {currency}\nPreço original: {price}\nVendedor: {seller}\nLinha: {raw_chat}",
  "patterns": [
    "\\bGTS\\s+Global\\b.*?(?P<seller>[A-Za-z0-9_]{2,16})\\s+added\\s+a[n]?\\s+(?P<item>.+?)\\s+to\\s+the\\s+global\\s+GTS\\s+for\\s+(?P<price_text>.+?)(?:!|$)",
    "\\bGTS\\s+Global\\b.*?(?P<seller>[A-Za-z0-9_]{2,16})\\s+added\\s+(?P<item>.+?)\\s+to\\s+the\\s+global\\s+GTS\\s+for\\s+(?P<price_text>.+?)(?:!|$)",
    "\\bGTS\\s+Global\\b.*?(?P<seller>[A-Za-z0-9_]{2,16})\\s+adicionou\\s+um[a]?\\s+(?P<item>.+?)\\s+ao\\s+GTS\\s+Global\\s+por\\s+(?P<price_text>.+?)(?:!|$)",
    "\\bGTS\\s+Global\\b.*?(?P<seller>[A-Za-z0-9_]{2,16})\\s+adicionou\\s+(?P<item>.+?)\\s+ao\\s+GTS\\s+Global\\s+por\\s+(?P<price_text>.+?)(?:!|$)"
  ]
}
